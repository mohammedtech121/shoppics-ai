# ── ShopPics AI — environment ──────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
#
# Both values are intentionally PUBLIC (NEXT_PUBLIC_):
# this app is 100% client-side — unsigned uploads + delivery-URL
# transformations. There is no server, no API key and no secret in the app.
#
#   CLOUD NAME  → Cloudinary Dashboard → (Product Environment) → Cloud name
#   PRESET      → Settings → Upload → "Add upload preset":
#                   • Signing mode: UNSIGNED
#                   • Name: shoppics_uploads (any name works — copy it here)
#                   • No folder / format restrictions (so the demo works)
#                 Then enable the "AI Background Removal" add-on (free tier)
#                 under Settings → Add-ons for the cutout step to work.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Optional — NOT used by the app ─────────────────────────────────────────
# Only add these if you want to poke at your own account from the command
# line (Admin API / signed uploads). Never commit real secrets.

# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
